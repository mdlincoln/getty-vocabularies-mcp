 "subject_of": [
  {
   "classified_as": [
    {
     "_label": "descriptive note",
     "id": "http://vocab.getty.edu/aat/300435416",
     "type": "Type"
    }
   ],
   "content": "The son of a Nuremburg goldsmith of the same name, Albrecht Dürer was a prolific, popular, and widely influential artist. He studied in Venice and brought Italianate painting styles and forms to Germany. He is perhaps best known for having made great advancements in the techniques and art of printmaking.",
   "id": "http://vocab.getty.edu/ulan/scopeNote/52112",
